# --- Variables lues par docker compose ---
POSTGRES_PASSWORD=change-moi
ACME_EMAIL=toi@mondomaine.fr
CATALYST_HOST=deploy.mondomaine.fr

# --- Serveur ---
PORT=3000
PUBLIC_URL=https://deploy.mondomaine.fr
BASE_DOMAIN=mondomaine.fr            # projets servis sur <slug>.mondomaine.fr

# --- Base de données ---
DATABASE_URL=postgres://catalyst:change-moi@postgres:5432/catalyst

# --- Accès ---
# Token admin : première connexion à l'interface (avant d'avoir connecté GitHub) et CLI `catalyst`.
ADMIN_TOKEN=                         # openssl rand -hex 32
# Comptes GitHub autorisés à se connecter (en plus de ceux gérés dans Réglages → Accès).
CATALYST_ADMINS=

# --- GitHub ---
# Recommandé : rien à mettre ici. Connecte GitHub depuis l'interface (Réglages → Connecter GitHub) :
# Catalyst crée une GitHub App privée et stocke ses identifiants dans DATA_DIR/github-app.json.
# Mode alternatif sans App : token fine-grained (Contents read, Metadata read, Commit statuses write)
# + un webhook par repo signé avec GITHUB_WEBHOOK_SECRET.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=               # openssl rand -hex 32

# --- Comportement ---
POLL_INTERVAL_SECONDS=600            # 10 min (secours) ; 60 si pas de webhook
WORKER_CONCURRENCY=1                 # builds simultanés (tous projets confondus)
KEEP_IMAGES=3                        # images conservées par projet pour rollback
BUILD_TIMEOUT_SECONDS=900
HEALTHCHECK_TIMEOUT_SECONDS=60

# --- Chemins (dans le conteneur) ---
DATA_DIR=/var/lib/catalyst           # config de la GitHub App (github-app.json, chmod 600)
WORKDIR=/var/lib/catalyst/repos      # clones git
SECRETS_DIR=/var/lib/catalyst/env    # un fichier <slug>.env par projet (chmod 600)
PROJECTS_FILE=/app/projects.yml

# --- Notifications ---
# Se règle dans l'interface (Réglages → Notifications). Facultatif : valeur par défaut si rien n'y est réglé.
DISCORD_WEBHOOK_URL=

# --- Divers ---
# ROLE=all                           # all | api | worker (découpage en 2 process)
# LOG_LEVEL=info

# --- Variables lues par docker compose ---
POSTGRES_PASSWORD=change-moi
ACME_EMAIL=toi@mondomaine.fr
CATALYST_HOST=deploy.mondomaine.fr

# --- Serveur ---
PORT=3000
PUBLIC_URL=https://localhost:5173
BASE_DOMAIN=hydroxios.fr            # projets servis sur <slug>.mondomaine.fr

# --- Base de données ---
DATABASE_URL=postgres://catalyst:change-moi@postgres:5432/catalyst

# --- GitHub ---
# Token fine-grained limité aux repos suivis : Contents read, Metadata read, Commit statuses write
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=               # openssl rand -hex 32

# --- API interne ---
ADMIN_TOKEN=a315202dcbf03ef94edc64c033489cab9a246fd1aab0d03af6ba565a7967d9c4                         # openssl rand -hex 32

# --- Comportement ---
POLL_INTERVAL_SECONDS=600            # 10 min (secours) ; 60 si pas de webhook
WORKER_CONCURRENCY=1                 # builds simultanés (tous projets confondus)
KEEP_IMAGES=3                        # images conservées par projet pour rollback
BUILD_TIMEOUT_SECONDS=900
HEALTHCHECK_TIMEOUT_SECONDS=60

# --- Chemins (dans le conteneur) ---
WORKDIR=.catalyst/repos      # clones git
SECRETS_DIR=.catalyst/env    # un fichier <slug>.env par projet (chmod 600)
PROJECTS_FILE=/app/projects.yml

# --- Notifications ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1558473364081877116/Qp8EVXRpdzjTrcPHO4bGlOXWRPypiMizUH9NOyQE8QDfFqXVi6U9hsi91pbB_w5o6fC5

# --- Divers ---
# ROLE=all                           # all | api | worker (découpage en 2 process)
# LOG_LEVEL=info

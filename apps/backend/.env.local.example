# Options du mode local (docker-compose.local.yml). Copier en .env.local si besoin, tout est facultatif.

# Token de la première connexion (défaut : catalyst-local-admin)
# ADMIN_TOKEN=

# Fréquence de détection des nouveaux commits (défaut : 30 s)
# POLL_INTERVAL_SECONDS=30

# Pushs instantanés en local : crée un canal sur https://smee.io, mets son URL ici AVANT de connecter GitHub,
# puis lance le relais :  npx smee-client --url https://smee.io/xxx --target http://catalyst.localhost/webhooks/github
# GITHUB_WEBHOOK_URL=https://smee.io/xxx

# Comptes GitHub autorisés en plus du créateur de l'App
# CATALYST_ADMINS=

# Notifications
# DISCORD_WEBHOOK_URL=

# Configuration de `npm run dev` (copier en .env.dev). Le front Vite tourne sur :5173 et proxifie vers :3000.
PORT=3000
HOST=127.0.0.1
PUBLIC_URL=http://localhost:5173
BASE_DOMAIN=localhost

# Postgres embarqué lancé par `npm run dev` (scripts/dev-db.mjs), données dans .catalyst/pg
DATABASE_URL=postgres://catalyst:catalyst@localhost:5433/catalyst

ADMIN_TOKEN=catalyst-dev-admin-token

# Données locales (ignorées par git)
DATA_DIR=.catalyst
WORKDIR=.catalyst/repos
SECRETS_DIR=.catalyst/env
PROJECTS_FILE=./projects.yml

# Pas de HTTPS en dev
TRAEFIK_ENTRYPOINT=web
TRAEFIK_CERT_RESOLVER=

POLL_INTERVAL_SECONDS=60
LOG_LEVEL=debug

# api = API + poller, sans worker (le worker a besoin de git et de Docker).
# Avec Docker accessible (Linux, WSL) : ROLE=all pour builder et déployer depuis le dev.
ROLE=api
